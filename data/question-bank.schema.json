{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sa-question-bank.schema.json",
  "title": "系统架构设计师本地题库",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "papers", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "status", "expectedQuestions", "parsedQuestions", "scoreableQuestions", "warnings"],
        "properties": {
          "year": { "type": "integer", "minimum": 2009, "maximum": 2021 },
          "status": { "enum": ["complete", "partial", "unavailable"] },
          "expectedQuestions": { "type": "integer", "minimum": 0 },
          "parsedQuestions": { "type": "integer", "minimum": 0 },
          "scoreableQuestions": { "type": "integer", "minimum": 0 },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "year", "number", "stem", "options", "answer", "questionPage", "answerPage", "containsVisual", "confidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^q-20(0[9]|1[0-9]|2[01])-([1-9]|[1-6][0-9]|7[0-5])$" },
          "year": { "type": "integer" },
          "number": { "type": "integer", "minimum": 1, "maximum": 75 },
          "stem": { "type": "string" },
          "options": {
            "type": "object",
            "required": ["A", "B", "C", "D"],
            "additionalProperties": false,
            "properties": {
              "A": { "type": "string" }, "B": { "type": "string" },
              "C": { "type": "string" }, "D": { "type": "string" }
            }
          },
          "answer": { "type": ["string", "null"], "pattern": "^[ABCD]$" },
          "candidateAnswer": { "type": ["string", "null"], "pattern": "^[ABCD]$" },
          "explanation": { "type": ["string", "null"] },
          "questionPage": { "type": ["integer", "null"] },
          "answerPage": { "type": ["integer", "null"] },
          "containsVisual": { "type": "boolean" },
          "confidence": { "enum": ["high", "review-needed"] }
        }
      }
    }
  }
}
